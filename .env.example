# Copy this file to .env and fill in the real IDs/token.
# .env is git-ignored; never commit it.

DISCORD_TOKEN=
GUILD_ID=

# Role allowed to run officer-only commands.
OFFICER_ROLE_ID=

# Channel where meeting and contest reminders are posted.
REMINDER_CHANNEL_ID=

# Channel where /roles posts the reaction-role panel.
ANNOUNCEMENTS_CHANNEL_ID=

# Club timezone. All times typed into slash commands use this timezone.
TIMEZONE=America/Chicago

# Existing roles used for category reminders and /roles reaction roles.
# Set an ID to 0 to skip that category's role ping/panel entry.
NUMBER_SENSE_ROLE_ID=0
GENERAL_MATHEMATICS_ROLE_ID=0
CALCULATOR_APPLICATIONS_ROLE_ID=0
GENERAL_SCIENCE_ROLE_ID=0

# --- Optional dev/test instance settings ---
# Use a separate SQLite file so test contests/meetings never touch production.
# EULER_DB_PATH=db/dev.sql

# Enables the /dev commands. Refuses to start unless EULER_DB_PATH is separate.
# DEV_MODE=false

# To load a different env file without editing .env, set this in the shell:
#   EULER_ENV_FILE=.env.dev python -m main
